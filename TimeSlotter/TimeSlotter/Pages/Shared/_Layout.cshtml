<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - TimeSlotter</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/TimeSlotter.styles.css" asp-append-version="true"/>
    @await RenderSectionAsync("Head", required: false)
</head>
@*
  App shell: no document scroll — only inner panes (e.g. slot lists) scroll.
  Navbar height is treated as h-14 (3.5rem) for content: h-[calc(100vh-3.5rem)] on app pages.
*@
<body class="flex h-screen flex-col overflow-hidden">
<header class="shrink-0">
    <div class="w-full border-b border-slate-800 bg-slate-900">
        <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6 sm:px-8">
            <a asp-area="" asp-page="/Index" class="text-xl font-bold tracking-tight text-white">TimeSlotter</a>

            <div class="flex items-center gap-6">
                <a asp-area="" asp-page="/Index" class="text-sm text-slate-400 transition-colors hover:text-white">Home</a>
                <a asp-area="" asp-page="/Privacy" class="text-sm text-slate-400 transition-colors hover:text-white">Privacy</a>
                <a asp-page="/User" class="text-sm text-slate-400 transition-colors hover:text-white">User</a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/Admin" class="text-sm text-slate-400 transition-colors hover:text-white">Admin</a>
                    <form method="post" asp-page="/Index" asp-page-handler="Logout" class="m-0">
                        <button type="submit"
                                class="rounded-md px-3 py-1.5 text-sm font-medium text-slate-400 transition-colors hover:bg-slate-800 hover:text-white focus:outline-none">
                            Logout
                        </button>
                    </form>
                }
                else
                {
                    <a asp-page="/Index" class="text-sm text-slate-400 transition-colors hover:text-white">Login</a>
                    <a asp-page="/Register" class="text-sm text-slate-400 transition-colors hover:text-white">Register</a>
                }
            </div>
        </div>
    </div>
</header>
<div class="flex min-h-0 flex-1 flex-col overflow-hidden">
    <main role="main" class="min-h-0 flex-1 overflow-hidden">
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
