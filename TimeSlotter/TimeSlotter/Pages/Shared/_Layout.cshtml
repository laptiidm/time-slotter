<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - TimeSlotter</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/TimeSlotter.styles.css" asp-append-version="true"/>
    @await RenderSectionAsync("Head", required: false)
</head>
@*
  App shell: no document scroll — only inner panes (e.g. slot lists) scroll.
  Navbar height is treated as h-14 (3.5rem) for content: h-[calc(100vh-3.5rem)] on app pages.
*@
<body class="flex h-screen flex-col overflow-hidden">
<header class="shrink-0">
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom bg-white shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-page="/Index">TimeSlotter</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-page="/User">User</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-page="/Admin">Admin Panel</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-page="/Login">Login</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="flex min-h-0 flex-1 flex-col overflow-hidden">
    <main role="main" class="min-h-0 flex-1 overflow-hidden">
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
