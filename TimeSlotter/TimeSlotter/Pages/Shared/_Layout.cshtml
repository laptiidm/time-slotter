<!DOCTYPE html>
<html lang="@(ViewData["HtmlLang"] as string ?? "en")">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - TimeSlotter</title>
    @* Tailwind only (no Bootstrap). Scoped CSS from Razor, if present. *@
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/TimeSlotter.styles.css" asp-append-version="true"/>
    @await RenderSectionAsync("Head", required: false)
</head>
@*
  App shell: no document scroll — only inner panes scroll.
  Navbar height matches h-16 (4rem): use h-[calc(100vh-4rem)] on full-height app pages.
*@
<body class="flex h-screen flex-col overflow-hidden bg-slate-950 text-slate-100 antialiased">
<header class="shrink-0">
    <div class="w-full border-b border-slate-800 bg-slate-900">
        <div class="mx-auto flex h-16 max-w-7xl items-center justify-between sm:px-6 lg:px-8">
            @* Brand left — account actions right *@
            <a asp-area="" asp-page="/Index" class="px-4 text-xl font-bold tracking-tight text-white sm:px-4"><span class="mx-2">Time-Slotter</span></a>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <nav class="flex flex-wrap items-center justify-end gap-x-2 gap-y-2 px-4 sm:px-4" aria-label="Обліковий запис">
                    <a asp-page="/Index" class="mx-2 px-2 py-1.5 text-sm text-slate-400 transition-colors hover:text-white">Увійти</a>
                    <a asp-page="/Register" class="mx-2 px-2 py-1.5 text-sm text-slate-400 transition-colors hover:text-white">Реєстрація</a>
                </nav>
            }
        </div>
    </div>
</header>
<div class="flex min-h-0 flex-1 flex-col overflow-hidden">
    <main role="main" class="min-h-0 flex-1 overflow-hidden">
        @RenderBody()
    </main>
</div>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
