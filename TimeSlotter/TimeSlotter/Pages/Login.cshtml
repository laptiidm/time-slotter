@page
@model TimeSlotter.Pages.LoginModel
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Login";
}

@*
  No navbar/footer — layout is _LayoutLogin.
  Card stays centered in the full viewport (layout wrapper handles flex + height).
*@
<div class="w-full max-w-md">
    <div class="rounded-2xl border border-slate-800 bg-slate-900 p-8 shadow-xl shadow-black/30 ring-1 ring-white/5">
        <header class="mb-8 text-center">
            <h1 class="text-xl font-semibold tracking-tight text-white">Sign in</h1>
            <p class="mt-1 text-sm text-slate-400">Enter your credentials to continue.</p>
        </header>

        <form method="post" asp-page="/Login" class="space-y-5">
            <div asp-validation-summary="All"
                 class="rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-200">
            </div>

            <div>
                <label asp-for="Input.EmailOrUsername" class="mb-1.5 block text-sm font-medium text-slate-300">
                    Email or username
                </label>
                <input asp-for="Input.EmailOrUsername"
                       type="text"
                       autocomplete="username"
                       required
                       placeholder="you@example.com"
                       class="block w-full rounded-md border-0 bg-slate-800 py-1.5 pl-3 pr-3 text-sm text-white shadow-sm ring-1 ring-inset ring-slate-700 placeholder:text-slate-500 focus:ring-2 focus:ring-inset focus:ring-blue-500 sm:leading-6"/>
            </div>

            <div>
                <label asp-for="Input.Password" class="mb-1.5 block text-sm font-medium text-slate-300">
                    Password
                </label>
                <input asp-for="Input.Password"
                       type="password"
                       autocomplete="current-password"
                       required
                       placeholder="••••••••"
                       class="block w-full rounded-md border-0 bg-slate-800 py-1.5 pl-3 pr-3 text-sm text-white shadow-sm ring-1 ring-inset ring-slate-700 placeholder:text-slate-500 focus:ring-2 focus:ring-inset focus:ring-blue-500 sm:leading-6"/>
            </div>

            <button type="submit"
                    class="mt-2 w-full rounded-md bg-blue-600 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-900">
                Login
            </button>
        </form>

        <p class="mt-4 text-center text-sm text-slate-400">
            Don't have an account?
            <a asp-page="/Register" class="font-medium text-blue-400 hover:underline">Register</a>
        </p>
    </div>
</div>
