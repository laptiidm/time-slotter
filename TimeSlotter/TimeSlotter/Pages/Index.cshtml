@page
@model IndexModel
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Login";
    var hasPosted = string.Equals(ViewContext.HttpContext.Request.Method, "POST", StringComparison.OrdinalIgnoreCase);
    var emailHasError = hasPosted
        && ViewData.ModelState.TryGetValue(nameof(Model.Email), out var emailState)
        && emailState.Errors.Count > 0;
    var passwordHasError = hasPosted
        && ViewData.ModelState.TryGetValue(nameof(Model.Password), out var passwordState)
        && passwordState.Errors.Count > 0;
    var defaultInputClasses = "block w-full rounded-md border-0 bg-slate-800 py-1.5 pl-3 pr-3 text-sm text-white shadow-sm placeholder:text-slate-500 sm:leading-6";
    var emailClasses = emailHasError
        ? $"{defaultInputClasses} ring-1 ring-inset ring-red-500 focus:ring-2 focus:ring-inset focus:ring-red-500"
        : $"{defaultInputClasses} ring-1 ring-inset ring-slate-700 focus:ring-2 focus:ring-inset focus:ring-blue-500";
    var passwordClasses = passwordHasError
        ? $"{defaultInputClasses} ring-1 ring-inset ring-red-500 focus:ring-2 focus:ring-inset focus:ring-red-500"
        : $"{defaultInputClasses} ring-1 ring-inset ring-slate-700 focus:ring-2 focus:ring-inset focus:ring-blue-500";
}

<div class="w-full max-w-md">
    <div class="rounded-2xl border border-slate-800 bg-slate-900 p-8 shadow-xl shadow-black/30 ring-1 ring-white/5">
        <header class="mb-8 text-center">
            <h1 class="text-xl font-semibold tracking-tight text-white">Sign in</h1>
            <p class="mt-1 text-sm text-slate-400">Access your dashboard and manage time slots.</p>
        </header>

        <form method="post" class="space-y-5">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-200">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <div>
                <label for="email" class="mb-1.5 block text-sm font-medium text-slate-300">Email</label>
                <input asp-for="Email"
                       id="email"
                       type="email"
                       autocomplete="username"
                       required
                       placeholder="you@example.com"
                       class="@emailClasses" />
            </div>

            <div>
                <label for="password" class="mb-1.5 block text-sm font-medium text-slate-300">Password</label>
                <input asp-for="Password"
                       id="password"
                       type="password"
                       autocomplete="current-password"
                       required
                        placeholder="Password"
                       class="@passwordClasses" />
            </div>

            <label for="rememberMe" class="flex items-center gap-3 text-sm text-slate-300">
                <input name="rememberMe" type="hidden" value="false" />
                <input id="rememberMe"
                       name="rememberMe"
                       type="checkbox"
                       value="true"
                       checked="@Model.RememberMe"
                       class="h-4 w-4 rounded border-slate-600 bg-slate-950 text-blue-500 focus:ring-blue-500" />
                Remember me
            </label>

            <button type="submit"
                    class="w-full rounded-md bg-blue-600 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-900">
                Login
            </button>
        </form>

        <p class="mt-4 text-center text-sm text-slate-400">
            New here?
            <a asp-page="/Register" class="font-medium text-blue-400 hover:underline">Create an account</a>
        </p>
    </div>
</div>
