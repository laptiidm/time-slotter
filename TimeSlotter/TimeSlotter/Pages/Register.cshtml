@page
@model TimeSlotter.Pages.RegisterModel
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Register";
    var hasPosted = string.Equals(ViewContext.HttpContext.Request.Method, "POST", StringComparison.OrdinalIgnoreCase);
    var emailBorderClass = hasPosted
        && ViewData.ModelState.TryGetValue("Input.Email", out var emailState)
        && emailState.Errors.Count > 0
            ? "ring-red-500 focus:ring-red-500"
            : "ring-slate-700 focus:ring-blue-500";
    var passwordBorderClass = hasPosted
        && ViewData.ModelState.TryGetValue("Input.Password", out var passwordState)
        && passwordState.Errors.Count > 0
            ? "ring-red-500 focus:ring-red-500"
            : "ring-slate-700 focus:ring-blue-500";
    var fullNameBorderClass = hasPosted
        && ViewData.ModelState.TryGetValue("Input.FullName", out var fullNameState)
        && fullNameState.Errors.Count > 0
            ? "ring-red-500 focus:ring-red-500"
            : "ring-slate-700 focus:ring-blue-500";
    var nicknameBorderClass = hasPosted
        && ViewData.ModelState.TryGetValue("Input.Nickname", out var nicknameState)
        && nicknameState.Errors.Count > 0
            ? "ring-red-500 focus:ring-red-500"
            : "ring-slate-700 focus:ring-blue-500";
    var inputBaseClasses = "block w-full rounded-md border-0 bg-slate-800 py-1.5 pl-3 pr-3 text-sm text-white shadow-sm ring-1 ring-inset placeholder:text-slate-500 focus:ring-2 focus:ring-inset sm:leading-6";
}

<div class="w-full max-w-md">
    <div class="rounded-2xl border border-slate-800 bg-slate-900 p-8 shadow-xl shadow-black/30 ring-1 ring-white/5">
        <header class="mb-8 text-center">
            <h1 class="text-xl font-semibold tracking-tight text-white">Create account</h1>
            <p class="mt-1 text-sm text-slate-400">Join to manage and book time slots.</p>
        </header>

        <form method="post" asp-page="/Register" class="space-y-5">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-200">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <div>
                <label asp-for="Input.Email" class="mb-1.5 block text-sm font-medium text-slate-300">Email</label>
                <input asp-for="Input.Email"
                       type="email"
                       autocomplete="email"
                       required
                       placeholder="you@example.com"
                       class="@($"{inputBaseClasses} {emailBorderClass}")" />
            </div>

            <div>
                <label asp-for="Input.Password" class="mb-1.5 block text-sm font-medium text-slate-300">Password</label>
                <input asp-for="Input.Password"
                       type="password"
                       required
                       placeholder="Minimum 6 characters"
                       class="@($"{inputBaseClasses} {passwordBorderClass}")"/>
            </div>

            <div>
                <label asp-for="Input.FullName" class="mb-1.5 block text-sm font-medium text-slate-300">Full name</label>
                <input asp-for="Input.FullName"
                       id="fullNameInput"
                       type="text"
                       required
                       placeholder="Jane Doe"
                       class="@($"{inputBaseClasses} {fullNameBorderClass}")"/>
            </div>

            <div>
                <label asp-for="Input.Nickname" class="mb-1.5 block text-sm font-medium text-slate-300">Nickname</label>
                <div class="relative">
                    <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-500">@@</span>
                    <input asp-for="Input.Nickname"
                           id="nicknameInput"
                           type="text"
                           required
                           placeholder="your-nickname"
                           class="@($"block w-full rounded-md border-0 bg-slate-800 py-1.5 pl-8 pr-3 text-sm text-white shadow-sm ring-1 ring-inset placeholder:text-slate-500 focus:ring-2 focus:ring-inset sm:leading-6 {nicknameBorderClass}")"/>
                </div>
                <p class="mt-2 text-xs text-slate-500">
                    Your public link:
                    <span class="text-slate-300">timeslotter.com/u/<span id="publicLinkSlug">your-nickname</span></span>
                </p>
            </div>

            <div>
                <label asp-for="Input.Description" class="mb-1.5 block text-sm font-medium text-slate-300">
                    Description <span class="text-slate-500">(optional)</span>
                </label>
                <textarea asp-for="Input.Description"
                          rows="4"
                          placeholder="Short bio (shown on your public page)"
                          class="block w-full rounded-md border-0 bg-slate-800 py-1.5 pl-3 pr-3 text-sm text-white shadow-sm ring-1 ring-inset ring-slate-700 placeholder:text-slate-500 focus:ring-2 focus:ring-inset focus:ring-blue-500 sm:leading-6"></textarea>
            </div>

            <button type="submit"
                    class="w-full rounded-md bg-blue-600 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-900">
                Register
            </button>
        </form>

        <p class="mt-5 text-center text-sm text-slate-400">
            Already have an account?
            <a asp-page="/Index" class="font-medium text-blue-400 hover:underline">Login</a>
        </p>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const fullName = document.getElementById('fullNameInput');
            const nickname = document.getElementById('nicknameInput');
            const slugEl = document.getElementById('publicLinkSlug');

            function slugify(value) {
                value = (value || '').trim().toLowerCase();
                if (value.length === 0) return '';
                // Replace runs of non-alphanumeric chars with hyphens.
                return value.replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
            }

            function sync() {
                if (!fullName || !nickname) return;
                const slug = slugify(fullName.value);
                nickname.value = slug;
                if (slugEl) slugEl.textContent = slug || 'your-nickname';
            }

            fullName?.addEventListener('input', sync);
            sync();
        })();
    </script>
}

