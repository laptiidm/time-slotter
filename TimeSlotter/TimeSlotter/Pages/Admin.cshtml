            function isValidContiguousMergeSet(ids) {
                if (!ids || ids.length === 0) return false;
                if (ids.length === 1) return true;
                var ymd = targetDate && targetDate.value;
                if (!ymd) return false;
                var rows = ids.map(function (id) {
                    return window.existingSlots.find(function (r) { return r.id === id; });
                }).filter(Boolean);
                if (rows.length !== ids.length) return false;
                var rk = null;
                for (var i = 0; i < rows.length; i++) {
                    normalizeRow(rows[i]);
                    if (rows[i].statusCode !== 0 || rows[i].date !== ymd) return false;
                    var k = mergeResourceKey(rows[i]);
                    if (rk === null) rk = k;
                    else if (k !== rk) return false;
                }
                rows.sort(function (a, b) { return hmToMinutes(a.start) - hmToMinutes(b.start); });
                for (var j = 0; j < rows.length - 1; j++) {
                    if (hmToMinutes(rows[j].end) !== hmToMinutes(rows[j + 1].start)) return false;
                }
                return true;
            }

            function tryToggleMergeSelection(slotId) {
                var row = window.existingSlots.find(function (r) { return r.id === slotId; });
                if (!row) return;
                normalizeRow(row);
                if (row.statusCode !== 0) {
                    showScheduleHint('Тільки послідовні вільні слоти!');
                    return;
                }
                var idx = selectedSlotIdsForMerge.indexOf(slotId);
                if (idx >= 0) {
                    selectedSlotIdsForMerge.splice(idx, 1);
                    updateGroupingChrome();
                    renderSlots();
                    return;
                }
                var tentative = selectedSlotIdsForMerge.concat([slotId]);
                if (!isValidContiguousMergeSet(tentative)) {
                    showScheduleHint('Тільки послідовні вільні слоти!');
                    return;
                }
                tentative.sort(function (a, b) {
                    var ra = window.existingSlots.find(function (r) { return r.id === a; });
                    var rb = window.existingSlots.find(function (r) { return r.id === b; });
                    return hmToMinutes(ra.start) - hmToMinutes(rb.start);
                });
                selectedSlotIdsForMerge = tentative;
                hideScheduleHint();
                updateGroupingChrome();
                renderSlots();
            }

            async function executeMergeSelection() {
                if (selectedSlotIdsForMerge.length < 2) return;
                var sorted = selectedSlotIdsForMerge.slice().sort(function (a, b) {
                    var ra = window.existingSlots.find(function (r) { return r.id === a; });
                    var rb = window.existingSlots.find(function (r) { return r.id === b; });
                    return hmToMinutes(ra.start) - hmToMinutes(rb.start);
                });
                var body = new URLSearchParams();
                sorted.forEach(function (id) { body.append('slotIds', String(id)); });
                body.set('__RequestVerificationToken', getCsrfToken());
                try {
                    var res = await fetch(adminUrl('MergeSlots'), {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
                        body: body.toString(),
                        credentials: 'same-origin'
                    });
                    var data = {};
