                if (groupingMode) {
                    adminGroupingBar.classList.remove('hidden');
                    adminGroupingBar.classList.remove('opacity-0', 'translate-y-2');
                    adminGroupingBar.classList.add('opacity-100', 'translate-y-0');
                } else {
                    adminGroupingBar.classList.add('opacity-0', 'translate-y-2');
                    adminGroupingBar.classList.remove('opacity-100', 'translate-y-0');
