@page
@model TimeSlotter.Pages.AdminModel
@using System
@{
    ViewData["Title"] = "Admin";
    ViewData["HtmlLang"] = "uk-UA";
    var bookingSlugEscaped = Uri.EscapeDataString(Model.BookingLinkSlug);
    var initialBookingFullUrl = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}/Booking?slug={bookingSlugEscaped}&date={Model.ScheduleInitialDate}";
    var publicLinkSaveFlash = string.Equals(TempData["AdminSlotsSaved"] as string, "1", StringComparison.Ordinal);
}

@*
  Single list: #unifiedTimeline merges existingSlots (DB) + draftSlots (id <= 0), sorted by start.
*@
<form id="adminCsrfForm" class="sr-only" aria-hidden="true">@Html.AntiForgeryToken()</form>
<script type="application/json" id="initialExistingSlots">@Html.Raw(Model.InitialSlotsJson)</script>

<div id="adminPageRoot" class="flex h-[calc(100vh-4rem)] flex-col overflow-hidden bg-slate-950 px-4 pb-4 pt-4 text-slate-100 sm:px-6" data-default-split-minutes="@Model.DefaultSlotIntervalMinutes" data-public-link-save-flash="@(publicLinkSaveFlash ? "1" : "0")">
    <div class="grid min-h-0 flex-1 grid-cols-1 gap-4 lg:grid-cols-[35%_65%] lg:gap-6">
        <aside class="flex min-h-0 flex-col lg:h-full">
            <div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-2xl border border-slate-800 bg-slate-900 shadow-lg shadow-black/20 ring-1 ring-white/5">
                <div class="min-h-0 flex-1 overflow-y-auto p-3 sm:p-4">
                    <header class="flex min-w-0 items-center gap-2" title="Signed in">
                        <span class="h-2 w-2 shrink-0 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(34,197,94,0.55)]" aria-hidden="true"></span>
                        <p class="min-w-0 truncate text-sm font-semibold leading-tight text-slate-100">@Model.Provider.Name</p>
                    </header>
                    <div class="my-3 border-t border-slate-800/50"></div>
                    @* Text HH:mm fields: consistent 24h UX; values match TryParseHm / parseHm24. *@
                    <section aria-label="Slot draft generator" lang="uk-UA">
                        <h2 class="mb-1 text-[10px] font-semibold uppercase tracking-wide text-slate-500">Configuration</h2>
                        <form id="slotDraftForm" method="post" asp-page-handler="Save" class="space-y-4" novalidate>
                            <div class="grid grid-cols-1 gap-1.5 sm:grid-cols-3">
                                <div class="min-w-0">
                                    <label for="targetDate" class="mb-[5px] block text-[10px] font-semibold uppercase leading-none tracking-wide text-slate-500">Target date</label>
                                    <input id="targetDate" type="date" required value="@Model.ScheduleInitialDate"
                                           class="block min-h-[2.25rem] w-full rounded-md border-0 bg-slate-800 py-1.5 px-2 text-xs text-white shadow-sm ring-1 ring-inset ring-slate-700 focus:ring-2 focus:ring-inset focus:ring-blue-500"/>
                                </div>
                                <div class="min-w-0">
                                    <label for="startTime" class="mb-[5px] block text-[10px] font-semibold uppercase leading-none tracking-wide text-slate-500">Start</label>
                                    <input id="startTime" type="text" value="09:00" required maxlength="5"
                                           inputmode="numeric" placeholder="HH:mm" pattern="[0-9]{2}:[0-9]{2}"
                                           autocomplete="off" spellcheck="false"
                                           aria-describedby="slotGenTimeFormatHint"
                                           title="24-годинний час ГГ:ХХ (можна ввести 0900)"
                                           class="time-mask-input block min-h-[2.25rem] w-full min-w-0 rounded-md border-0 bg-slate-800 py-1.5 px-2 font-mono text-xs tabular-nums text-white shadow-sm ring-1 ring-inset ring-slate-700 focus:ring-2 focus:ring-inset focus:ring-blue-500"/>
                                </div>
                                <div class="min-w-0">
                                    <label for="endTime" class="mb-[5px] block text-[10px] font-semibold uppercase leading-none tracking-wide text-slate-500">End</label>
                                    <input id="endTime" type="text" value="17:00" required maxlength="5"
                                           inputmode="numeric" placeholder="HH:mm" pattern="[0-9]{2}:[0-9]{2}"
                                           autocomplete="off" spellcheck="false"
                                           aria-describedby="slotGenTimeFormatHint"
                                           title="24-годинний час ГГ:ХХ (можна ввести 0900)"
                                           class="time-mask-input block min-h-[2.25rem] w-full min-w-0 rounded-md border-0 bg-slate-800 py-1.5 px-2 font-mono text-xs tabular-nums text-white shadow-sm ring-1 ring-inset ring-slate-700 focus:ring-2 focus:ring-inset focus:ring-blue-500"/>
                                </div>
                            </div>
                            <p id="slotGenTimeFormatHint" class="sr-only">Час у 24-годинному форматі; значення поля у вигляді ГГ:ХХ.</p>

                            <div class="grid grid-cols-1 gap-1.5 sm:grid-cols-[2fr_1fr]">
                                <div class="min-w-0">
                                    <label for="strategy" class="mb-[5px] block text-[10px] font-semibold uppercase leading-none tracking-wide text-slate-500">Strategy</label>
                                    <select id="strategy"
                                            class="block min-h-[2.25rem] w-full min-w-0 rounded-md border-0 bg-slate-800 py-1.5 px-2 text-xs text-white shadow-sm ring-1 ring-inset ring-slate-700 focus:ring-2 focus:ring-inset focus:ring-blue-500">
                                        <option value="interval">Fixed interval (minutes per slot)</option>
                                        <option value="equal">Equal split (number of slots)</option>
                                    </select>
                                </div>
                                <div class="min-w-0">
                                    <label for="generationValue" class="mb-[5px] block text-[10px] font-semibold uppercase leading-none tracking-wide text-slate-500">
                                        <span id="generationLabel">Interval (min)</span>
                                    </label>
                                    <input id="generationValue" type="number" min="1" max="480" step="1" value="60" required inputmode="numeric"
                                           class="block min-h-[2.25rem] w-full rounded-md border-0 bg-slate-800 py-1.5 px-2 text-xs text-white shadow-sm ring-1 ring-inset ring-slate-700 focus:ring-2 focus:ring-inset focus:ring-blue-500"/>
                                </div>
                            </div>
                            <p class="text-[10px] leading-tight text-slate-500" id="strategyHelp">Each slot will be this many minutes long, placed back-to-back from start until end.</p>

                            <div class="border-t border-slate-800/50 pt-3">
                            <div class="grid grid-cols-1 gap-1.5 sm:grid-cols-3">
                                <button type="button" id="generatePreviewBtn"
                                        class="min-h-[2.25rem] w-full min-w-0 rounded-lg bg-blue-600 px-2 py-1.5 text-xs font-semibold text-white transition hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-900">
                                    Preview
                                </button>
                                <button type="submit" id="saveDraftBtn" disabled
                                        class="min-h-[2.25rem] w-full min-w-0 rounded-lg bg-emerald-600 px-2 py-1.5 text-xs font-bold text-white transition hover:bg-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-900 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-emerald-600">
                                    Save
                                </button>
                                <button type="button" id="clearDayBtn" disabled
                                        class="min-h-[2.25rem] w-full min-w-0 rounded-lg border border-red-500/50 bg-red-950/40 px-2 py-1.5 text-xs font-semibold text-red-300 transition hover:bg-red-950/60 focus:outline-none focus:ring-2 focus:ring-red-500/50 disabled:cursor-not-allowed disabled:border-slate-700 disabled:bg-slate-800/50 disabled:text-slate-600">
                                    Clear
                                </button>
                            </div>
                            </div>
                        </form>
                    </section>
                </div>
            </div>
        </aside>

        <section id="adminTimelineSection" class="flex min-h-0 flex-1 flex-col lg:min-h-0 lg:h-full transition-[box-shadow] duration-300" aria-label="Schedule timeline">
            <div id="adminTimelinePanel" class="flex min-h-0 min-h-[min(100%,calc(100vh-5rem))] flex-1 flex-col overflow-hidden rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-black/20 ring-1 ring-white/5 transition-[box-shadow,ring-color] duration-300" data-booking-slug="@Model.BookingLinkSlug">
                <input id="permanentBookingLinkInput" type="text" readonly tabindex="-1"
                       value="@initialBookingFullUrl"
                       class="sr-only"
                       autocomplete="off" spellcheck="false" aria-hidden="true"/>
                @if (string.IsNullOrEmpty(Model.BookingLinkSlug))
                {
                    <p class="mb-2 shrink-0 text-[10px] leading-snug text-amber-200/90">Додайте slug профілю в налаштуваннях, щоб публічне посилання працювало.</p>
                }
                <div class="mb-3 flex min-h-[2.25rem] shrink-0 flex-wrap items-center justify-between gap-2">
                    <div class="flex min-w-0 flex-wrap items-center gap-2">
                        <button type="button" id="publicBookingLinkBtn" disabled
                                class="inline-flex min-h-[2.25rem] shrink-0 items-center gap-1.5 rounded-lg border border-slate-600/80 bg-transparent px-3 py-1.5 text-xs font-medium text-slate-200 transition hover:border-slate-500 hover:bg-slate-800/80 focus:outline-none focus:ring-2 focus:ring-blue-500/40 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:border-slate-600/80 disabled:hover:bg-transparent"
                                title="Copy booking link for the target date (saved slots required)">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                            <span>Public link</span>
                        </button>
                        <span id="permanentBookingCopyFeedback" class="hidden text-[10px] font-medium text-emerald-400" role="status">Copied</span>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        <span id="timelineCountBadge" class="rounded-full border border-slate-700 bg-slate-950 px-2 py-0.5 text-xs text-slate-400">0</span>
                        <button type="button" id="scheduleRefreshBtn"
                                class="min-h-[2.25rem] rounded-lg border border-slate-600 bg-transparent px-3 py-1.5 text-xs font-medium text-slate-300 transition hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-transparent">
                            Refresh
                        </button>
                        <button type="button" id="clearAllBtn" disabled
                                class="min-h-[2.25rem] rounded-lg border border-slate-600 bg-transparent px-3 py-1.5 text-xs font-medium text-slate-300 transition hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-transparent">
                            Clear draft
                        </button>
                        <button type="button" id="adminGroupingToggleBtn" disabled
                                class="min-h-[2.25rem] rounded-lg border border-indigo-500/40 bg-indigo-950/40 px-3 py-1.5 text-xs font-medium text-indigo-200 transition hover:bg-indigo-900/50 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-indigo-950/40">
                            Групувати
                        </button>
                    </div>
                </div>
                <p class="mb-2 shrink-0 text-xs text-slate-500">One chronological list for the target date. Polls every 30s.</p>
                <p id="scheduleHint" class="mb-3 hidden shrink-0 rounded-lg border border-amber-500/30 bg-amber-500/10 px-2 py-1.5 text-xs text-amber-200" role="status"></p>
                <div id="draftValidationWarning" class="mb-3 hidden shrink-0 rounded-lg border border-amber-500/40 bg-amber-500/10 px-3 py-2 text-sm text-amber-200" role="alert"></div>
                <input type="hidden" name="FinalSlotsJson" id="finalSlotsJson" value="" form="slotDraftForm"/>

                <div id="timelineEmptyState" class="flex min-h-0 flex-1 flex-col items-center justify-center rounded-lg border border-dashed border-slate-700 bg-slate-950/30 p-6 text-center">
                    <p class="text-sm text-slate-500">No slots for this date. Use <span class="text-slate-400">Generate preview</span> or load saved slots.</p>
                </div>
                <div id="unifiedTimeline" class="hidden min-h-0 flex-1 grid-cols-1 gap-3 overflow-y-auto overflow-x-hidden pr-1"></div>
            </div>
        </section>
    </div>
</div>

<div id="adminGroupingBar" class="fixed bottom-6 left-1/2 z-[95] hidden w-[min(calc(100%-2rem),28rem)] max-w-full -translate-x-1/2 translate-y-2 opacity-0 transition-all duration-300 ease-out" role="region" aria-label="Режим групування слотів">
    <div class="pointer-events-auto relative rounded-2xl border border-indigo-500/35 bg-slate-900/95 px-4 pb-3 pt-8 shadow-2xl shadow-black/50 ring-1 ring-indigo-500/25 backdrop-blur-md">
        <button type="button" id="adminGroupingBarCloseBtn" title="Закрити режим групування"
                class="absolute right-2 top-2 inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-800 hover:text-slate-100"
                aria-label="Закрити">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
        <div class="flex flex-wrap items-center justify-center gap-2">
            <button type="button" id="adminGroupingMergeBtn" disabled
                    class="rounded-lg bg-indigo-600 px-4 py-2 text-xs font-semibold text-white shadow-lg transition hover:bg-indigo-500 disabled:cursor-not-allowed disabled:opacity-40">
                Об'єднати (<span id="adminGroupingCount">0</span>)
            </button>
            <button type="button" id="adminGroupingBarCancelBtn"
                    class="rounded-lg border border-slate-600 bg-slate-800/80 px-4 py-2 text-xs font-medium text-slate-200 transition hover:bg-slate-700">
                Скасувати
            </button>
        </div>
    </div>
</div>

<div id="clearDayModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/65 p-4 backdrop-blur-[2px]" aria-hidden="true" aria-labelledby="clearDayModalTitle" role="dialog">
    <div class="w-full max-w-md rounded-2xl border border-slate-700 bg-slate-900 p-6 shadow-2xl ring-1 ring-white/10">
        <h3 id="clearDayModalTitle" class="mb-2 text-lg font-semibold text-white">Очистити день?</h3>
        <p id="clearDayModalText" class="mb-6 text-sm leading-relaxed text-slate-400"></p>
        <div class="flex flex-wrap justify-end gap-2">
            <button type="button" id="clearDayModalCancel"
                    class="rounded-lg border border-slate-600 bg-transparent px-4 py-2 text-sm font-medium text-slate-300 hover:bg-slate-800">
                Скасувати
            </button>
            <button type="button" id="clearDayModalConfirm"
                    class="rounded-lg border border-red-600 bg-red-600/25 px-4 py-2 text-sm font-semibold text-red-200 hover:bg-red-600/40">
                Очистити всі збережені слоти
            </button>
        </div>
    </div>
</div>

<div id="splitIntervalModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/65 p-4 backdrop-blur-[2px]" aria-hidden="true" aria-labelledby="splitIntervalModalTitle" role="dialog">
    <div class="w-full max-w-md rounded-2xl border border-violet-500/30 bg-slate-900 p-5 shadow-2xl ring-1 ring-violet-500/20">
        <h3 id="splitIntervalModalTitle" class="mb-3 text-base font-semibold text-white">Розгрупувати слот</h3>
        <label for="splitIntervalModalInput" class="mb-1.5 block text-sm text-slate-400">Введіть інтервал для розбиття (хв):</label>
        <input id="splitIntervalModalInput" type="number" min="5" max="480" step="1" inputmode="numeric"
               class="mb-5 block w-full rounded-lg border-0 bg-slate-800 py-2 pl-3 pr-3 text-sm text-white ring-1 ring-inset ring-slate-600 focus:outline-none focus:ring-2 focus:ring-violet-500/50"/>
        <div class="flex flex-wrap justify-end gap-2">
            <button type="button" id="splitIntervalModalCancel"
                    class="rounded-lg border border-slate-600 bg-transparent px-4 py-2 text-sm font-medium text-slate-300 hover:bg-slate-800">
                Скасувати
            </button>
            <button type="button" id="splitIntervalModalConfirm"
                    class="rounded-lg border border-violet-500/50 bg-violet-600/25 px-4 py-2 text-sm font-semibold text-violet-100 hover:bg-violet-600/40">
                Розбити
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            window.draftSlots = window.draftSlots || [];
            window.existingSlots = window.existingSlots || [];

            const maxSlots = 96;
            let nextDraftId = -1;

            const targetDate = document.getElementById('targetDate');
            const startTimeEl = document.getElementById('startTime');
            const endTimeEl = document.getElementById('endTime');
            const strategy = document.getElementById('strategy');
            const generationValue = document.getElementById('generationValue');
            const generationLabel = document.getElementById('generationLabel');
            const strategyHelp = document.getElementById('strategyHelp');
            const generateBtn = document.getElementById('generatePreviewBtn');
            const clearBtn = document.getElementById('clearAllBtn');
            const refreshBtn = document.getElementById('scheduleRefreshBtn');
            const form = document.getElementById('slotDraftForm');
            const finalJson = document.getElementById('finalSlotsJson');
            const saveBtn = document.getElementById('saveDraftBtn');
            const clearDayBtn = document.getElementById('clearDayBtn');
            const clearDayModal = document.getElementById('clearDayModal');
            const clearDayModalText = document.getElementById('clearDayModalText');
            const clearDayModalCancel = document.getElementById('clearDayModalCancel');
            const clearDayModalConfirm = document.getElementById('clearDayModalConfirm');
            const unifiedTimeline = document.getElementById('unifiedTimeline');
            const timelineEmpty = document.getElementById('timelineEmptyState');
            const timelineBadge = document.getElementById('timelineCountBadge');
            const validationWarning = document.getElementById('draftValidationWarning');
            const scheduleHint = document.getElementById('scheduleHint');
            const csrfForm = document.getElementById('adminCsrfForm');
            const initialEl = document.getElementById('initialExistingSlots');
            const permanentBookingInput = document.getElementById('permanentBookingLinkInput');
            const publicBookingLinkBtn = document.getElementById('publicBookingLinkBtn');
            const permanentBookingCopyFeedback = document.getElementById('permanentBookingCopyFeedback');
            const adminGroupingToggleBtn = document.getElementById('adminGroupingToggleBtn');
            const adminGroupingBar = document.getElementById('adminGroupingBar');
            const adminGroupingMergeBtn = document.getElementById('adminGroupingMergeBtn');
            const adminGroupingBarCancelBtn = document.getElementById('adminGroupingBarCancelBtn');
            const adminGroupingBarCloseBtn = document.getElementById('adminGroupingBarCloseBtn');
            const adminGroupingCount = document.getElementById('adminGroupingCount');
            const adminTimelinePanel = document.getElementById('adminTimelinePanel');
            const adminPageRoot = document.getElementById('adminPageRoot');
            const splitIntervalModal = document.getElementById('splitIntervalModal');
            const splitIntervalModalInput = document.getElementById('splitIntervalModalInput');
            const splitIntervalModalCancel = document.getElementById('splitIntervalModalCancel');
            const splitIntervalModalConfirm = document.getElementById('splitIntervalModalConfirm');

            let pollTimer = null;
            var pendingSplitSlotId = null;
            var splitModalKeydownHandler = null;
            var groupingMode = false;
            var selectedSlotIdsForMerge = [];

            function normalizeRow(row) {
                if (typeof row.statusCode !== 'number') {
                    var st = row.status || '';
                    row.statusCode = st === 'Available' ? 0 : st === 'BookedByClient' ? 2 : st === 'ReservedByAdmin' ? 3 : 0;
                }
                if (typeof row.isGrouped !== 'boolean') row.isGrouped = false;
                return row;
            }

            function getDefaultSplitMinutes() {
                var raw = adminPageRoot && adminPageRoot.getAttribute('data-default-split-minutes');
                var v = parseInt(raw || '30', 10);
                if (!Number.isFinite(v)) v = 30;
                return Math.max(5, Math.min(480, v));
            }

            function openSplitIntervalModal(slotId) {
                pendingSplitSlotId = slotId;
                if (splitIntervalModalInput) splitIntervalModalInput.value = String(getDefaultSplitMinutes());
                if (splitIntervalModal) {
                    splitIntervalModal.classList.remove('hidden');
                    splitIntervalModal.classList.add('flex');
                    splitIntervalModal.setAttribute('aria-hidden', 'false');
                }
                if (splitModalKeydownHandler) {
                    document.removeEventListener('keydown', splitModalKeydownHandler);
                }
                splitModalKeydownHandler = function (ev) {
                    if (ev.key === 'Escape') closeSplitIntervalModal();
                };
                document.addEventListener('keydown', splitModalKeydownHandler);
                window.setTimeout(function () {
                    if (splitIntervalModalInput) {
                        splitIntervalModalInput.focus();
                        splitIntervalModalInput.select();
                    }
                }, 0);
            }

            function closeSplitIntervalModal() {
                pendingSplitSlotId = null;
                if (splitIntervalModal) {
                    splitIntervalModal.classList.add('hidden');
                    splitIntervalModal.classList.remove('flex');
                    splitIntervalModal.setAttribute('aria-hidden', 'true');
                }
                if (splitModalKeydownHandler) {
                    document.removeEventListener('keydown', splitModalKeydownHandler);
                    splitModalKeydownHandler = null;
                }
            }

            function exitGroupingMode() {
                setGroupingMode(false);
            }

            (function seedExisting() {
                if (!initialEl || !initialEl.textContent || !initialEl.textContent.trim()) return;
                try {
                    var o = JSON.parse(initialEl.textContent);
                    var arr = o.slots || [];
                    window.existingSlots = arr.map(normalizeRow);
                } catch (e) { /* ignore */ }
            })();

            function getCsrfToken() {
                const el = csrfForm && csrfForm.querySelector('input[name="__RequestVerificationToken"]');
                return el ? el.value : '';
            }

            function adminUrl(handler, extra) {
                var u = new URL(window.location.href);
                u.search = '';
                u.searchParams.set('handler', handler);
                if (extra) {
                    Object.keys(extra).forEach(function (k) {
                        if (extra[k] != null) u.searchParams.set(k, String(extra[k]));
                    });
                }
                return u.toString();
            }

            function showScheduleHint(msg) {
                if (!scheduleHint) return;
                scheduleHint.textContent = msg;
                scheduleHint.classList.remove('hidden');
            }

            function hideScheduleHint() {
                if (!scheduleHint) return;
                scheduleHint.classList.add('hidden');
                scheduleHint.textContent = '';
            }

            function hideValidation() {
                if (!validationWarning) return;
                validationWarning.classList.add('hidden');
                validationWarning.textContent = '';
            }

            function showValidation(msg) {
                if (!validationWarning) return;
                validationWarning.textContent = msg;
                validationWarning.classList.remove('hidden');
            }

            function todayYmd() {
                const d = new Date();
                return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
            }
            if (targetDate && !targetDate.value) targetDate.value = todayYmd();

            function getBookingSlugForUrl() {
                return (adminTimelinePanel && adminTimelinePanel.getAttribute('data-booking-slug')) || '';
            }

            function updatePermanentBookingLink() {
                if (!permanentBookingInput || !targetDate) return;
                var slug = getBookingSlugForUrl();
                var ymd = targetDate.value || '';
                if (!ymd) return;
                permanentBookingInput.value = window.location.origin + '/Booking?slug=' + encodeURIComponent(slug) + '&date=' + encodeURIComponent(ymd);
            }

            /* Tailwind-only: 2s pulse after successful server save (see TempData + data-public-link-save-flash). */
            function pulsePublicLinkAfterSave() {
                var btn = publicBookingLinkBtn;
                if (!btn || btn.disabled) return;
                btn.classList.add('animate-pulse', 'ring-2', 'ring-emerald-400/50', 'ring-offset-2', 'ring-offset-slate-900');
                window.clearTimeout(pulsePublicLinkAfterSave._t);
                pulsePublicLinkAfterSave._t = window.setTimeout(function () {
                    btn.classList.remove('animate-pulse', 'ring-2', 'ring-emerald-400/50', 'ring-offset-2', 'ring-offset-slate-900');
                }, 2000);
            }

