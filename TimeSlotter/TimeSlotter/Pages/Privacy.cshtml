@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="h-[calc(100vh-4rem)] overflow-y-auto bg-slate-950 px-4 py-8 sm:px-6">
    <div class="mx-auto max-w-3xl rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-lg ring-1 ring-white/5 sm:p-8">
        <h1 class="text-2xl font-semibold tracking-tight text-white">@ViewData["Title"]</h1>
        <p class="mt-4 text-sm leading-relaxed text-slate-400">
            Use this page to detail your site's privacy policy.
        </p>
    </div>
</div>
