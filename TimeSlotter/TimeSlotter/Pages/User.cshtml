@page "/u/{slug}"
@model TimeSlotter.Pages.UserModel
@using System.Globalization
@{
    ViewData["Title"] = "Бронювання";
    ViewData["HtmlLang"] = "uk-UA";
    var uk = new CultureInfo("uk-UA");
}

@*
  Content height = viewport minus _Layout navbar (h-16 / 4rem).
  No page-level scroll; only the right column list scrolls when content exists.
*@
<div class="flex h-[calc(100vh-4rem)] flex-col overflow-hidden bg-slate-950 px-4 pb-4 pt-4 text-slate-100 sm:px-6">
    <header class="shrink-0 pb-4">
        <h1 class="text-2xl font-semibold tracking-tight text-white">Забронювати слот</h1>
        <p class="mt-1 text-sm text-slate-400">Оберіть дату, потім вільний час.</p>
    </header>

    <div class="grid min-h-0 flex-1 grid-cols-1 gap-4 lg:grid-cols-[35%_65%] lg:gap-6">
        @* Left: static calendar shell (data wiring comes later). *@
        <aside class="flex min-h-0 flex-col lg:h-full">
            <div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-2xl border border-slate-800 bg-slate-900 shadow-lg shadow-black/20 ring-1 ring-white/5">
                <div class="min-h-0 flex-1 overflow-y-auto p-6">
                    <section aria-label="Календар">
                        <div class="mb-4 flex items-center justify-between">
                            <h2 class="text-sm font-medium text-slate-300">@Model.SelectedDate.ToString("MMMM yyyy", uk)</h2>
                            <div class="flex gap-1">
                                <span class="rounded-md border border-slate-700 px-2 py-1 text-xs text-slate-400">&lsaquo;</span>
                                <span class="rounded-md border border-slate-700 px-2 py-1 text-xs text-slate-400">&rsaquo;</span>
                            </div>
                        </div>
                        <div class="mb-2 grid grid-cols-7 gap-1 text-center text-[10px] font-medium uppercase tracking-wide text-slate-500">
                            <span>Пн</span><span>Вт</span><span>Ср</span><span>Чт</span><span>Пт</span><span>Сб</span><span>Нд</span>
                        </div>
                        <div class="grid grid-cols-7 gap-1">
                            @for (var i = 0; i < 28; i++)
                            {
                                var day = i + 1;
                                var isToday = day == 2;
                                <div class="@(isToday ? "border-blue-500 bg-blue-600/20 text-blue-200" : "border-slate-700/80 text-slate-300") flex aspect-square items-center justify-center rounded-lg border text-xs font-medium">
                                    @day
                                </div>
                            }
                        </div>
                    </section>
                </div>
            </div>
        </aside>

        @* Right: reserved for slot list — empty for now, scroll ready. *@
        <section class="flex min-h-0 flex-col lg:h-full" aria-label="Доступні слоти">
            <div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-black/20 ring-1 ring-white/5">
                <div class="mb-4 flex shrink-0 items-center justify-between">
                    <h2 class="text-sm font-medium text-slate-300">Доступний час</h2>
                </div>
                <div class="min-h-0 flex-1 overflow-y-auto overflow-x-hidden pr-1">
                    @if (Model.AvailableSlots.Any())
                    {
                        <div class="space-y-3">
                            @foreach (var slot in Model.AvailableSlots)
                            {
                                <article class="rounded-xl border border-slate-700/80 bg-slate-950/50 p-4 ring-1 ring-white/5">
                                    <form method="post" asp-page-handler="Book" asp-route-slug="@Model.ProviderSlug" class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-end">
                                        <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")"/>
                                        @if (!string.IsNullOrEmpty(Model.SelectedResource))
                                        {
                                            <input type="hidden" name="resource" value="@Model.SelectedResource"/>
                                        }
                                        <input type="hidden" name="slotId" value="@slot.Id"/>
                                        <div class="min-w-[14rem]">
                                            <div class="flex items-center justify-between gap-3 font-mono text-sm text-slate-300">
                                                <span class="shrink-0">@slot.StartTime.ToString("HH:mm") – @slot.EndTime.ToString("HH:mm")</span>
                                                <span class="min-w-[5.5rem] truncate text-right font-sans text-xs text-slate-500">@(!string.IsNullOrWhiteSpace(slot.ResourceContext) ? slot.ResourceContext : "\u00A0")</span>
                                            </div>
                                        </div>
                                        <div class="flex flex-1 flex-col gap-2 sm:flex-row sm:gap-2">
                                            <input name="customerName" type="text" required maxlength="120" placeholder="Ім'я"
                                                   class="min-w-0 flex-1 rounded-md border-0 bg-slate-800 py-1.5 px-3 text-sm text-white ring-1 ring-inset ring-slate-600 placeholder:text-slate-500 focus:ring-2 focus:ring-blue-500"/>
                                            <input name="customerPhone" type="tel" required maxlength="40" placeholder="Телефон"
                                                   class="min-w-0 flex-1 rounded-md border-0 bg-slate-800 py-1.5 px-3 text-sm text-white ring-1 ring-inset ring-slate-600 placeholder:text-slate-500 focus:ring-2 focus:ring-blue-500"/>
                                        </div>
                                        <textarea name="clientComment" maxlength="200" rows="2" placeholder="Коментар до бронювання (необов'язково)"
                                                  class="w-full rounded-md border-0 bg-slate-800 py-1.5 px-3 text-sm text-white ring-1 ring-inset ring-slate-600 placeholder:text-slate-500 focus:ring-2 focus:ring-blue-500 sm:basis-full"></textarea>
                                        <button type="submit"
                                                class="shrink-0 rounded-lg bg-blue-600 px-4 py-2 text-xs font-semibold text-white hover:bg-blue-500">
                                            Забронювати
                                        </button>
                                    </form>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-sm text-slate-500">На цю дату немає вільних слотів.</p>
                    }
                </div>
            </div>
        </section>
    </div>
</div>
